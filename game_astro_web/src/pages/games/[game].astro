---
import DupaLogo from '@/assets/my_logo.png';
import Button from '@/components/Button.astro';
import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Image from 'astro/components/Image.astro';

import ControlsPopover from '@/components/ControlsPopover.astro';
import FullScreenIcon from '@lucide/astro/icons/expand';
import { getCollection, render, type CollectionEntry } from 'astro:content';

// Generate a new page for every file inside the content/
export async function getStaticPaths() {
	const games = await getCollection('games');
	return games.map((entry: CollectionEntry<'games'>) => ({
		params: { game: entry.id },
		props: { game: entry },
	}));
}

const gamesCollection = await getCollection('games');

// Here is how we access the data for each page from its .md file in content/
type Props = { game: CollectionEntry<'games'> };

const { game }: Props = Astro.props; // This stores the frontmatter data
const { Content } = await render(game); // This converts the content from .md syntax to html + css

// console.log("File path:", game.filePath);
// console.log("game id:", game.id);
---

<Layout>
	<Header {gamesCollection} />
	<article class="body">
		<div class="game-window">
			<div class="iframe-wrapper">
				<iframe
					src={`/games/${game.id}/build/web/index.html`}
					allow="autoplay; fullscreen"
					allow="cross-origin-isolated"
					/>
			</div>

			<footer>
				<div class="left-items">
					<Image src={DupaLogo} alt="Dupa Games Logo" width={80} />
					<div class="game-info">
						<h4 class="game-type">{game.data.type}</h4>
						<h1 class="game-title">{game.data.title}</h1>
					</div>
				</div>

				<div class="icons">
					<ControlsPopover />
					<!-- <Button><FullScreenIcon size={44} /></Button> -->
				</div>
			</footer>
		</div>

		<div class="game-description">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.body {
		display: flex;
		flex-direction: column;
		justify-self: center;
		gap: var(--gap-4);
		padding-inline: var(--gap-4);

		@media (min-width: 1024px) {
			padding-inline: var(--gap-6);
		}

		@media (min-width: 1440px) {
			padding-inline: var(--gap-8);
		}
	}

	.game-window {
		display: flex;
		justify-self: center;
		flex-direction: column;
	}
	
	.iframe-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 9 / 16;
		max-height: 85dvh;
		
		@media (min-width: 1024px) {
			aspect-ratio: 16 / 9;
		}
	}

	.iframe-wrapper iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		object-position: center center;
		object-fit: cover;
	}

	.game-info {
		display: flex;
		flex-direction: column;
		align-self: center;
	}

	/* TODO: this is WIP */
	.game-title {
		font-size: var(--font-md);

		@media (min-width: 1024px) {
			font-size: var(--font-lg);
		}
	}

	.icons {
		display: flex;
		gap: var(--gap-6);
		align-items: center;
	}

	.left-items {
		display: flex;
		gap: var(--gap-4);
	}

	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--gap-3) var(--gap-5);
		
		background-color: var(--color-surface);
		border-bottom-left-radius: var(--radius-md);
		border-bottom-right-radius: var(--radius-md);
	}
	
	.game-description {
		color: var(--color-text);
		font-size: var(--font-lg);
		font-family: var(--font-oswald);

		@media (min-width: 1024px) {
			padding-inline: var(--gap-6);
		}

		background-color: var(--color-surface);
		border-radius: var(--radius-md);
		padding: var(--gap-5);
	}
</style>
