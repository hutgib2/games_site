---
// JavaScript Section
import DupaLogoText from '@/assets/my_logo_text.png';
import GameCard from '@/components/GameCard.astro';
import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Image from 'astro/components/Image.astro';
import { getCollection } from 'astro:content';

const games = await getCollection('games');
---

<Layout>
	<div class="header">
		<Header games={games} />
	</div>
	<section class="body">
		<div class="welcome-video">
			<video src="the-surviving-vampire-preview.mp4" autoplay muted loop></video>
			<Image src={DupaLogoText} alt="Dupa Games Logo" width={240} />
		</div>
		<h1 class="game-heading">Browse all games</h1>
		<ul class="game-grid">
			{
				games.map((game: any) => (
					<li>
						<GameCard
							title={game.data.title}
							description={game.data.description}
							image={game.data.image}
							href={`games/${game.id}`}
						/>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<!-- 
	There are two ways to write CSS in an astro file
	1. Write styles inside page's <style> - only applies to elements in current file
	2. Import a css file from styles/ - can apply to multiple files or globally
-->

<!-- CSS Section - allows us to add scoped CSS to our html -->
<style>
	.header {
		position: absolute;
		inset: 0;
		z-index: 10;
	}

	.body {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--gap-4);

		@media (min-width: 1024px) {
			gap: var(--gap-8);
		}
	}

	.welcome-video {
		display: flex;
		position: relative;
		flex-direction: column;
		justify-content: center;
		align-items: center;

		width: 100%;
		height: 50dvh;
		overflow: hidden;
		z-index: 1;
		
	}
	
	video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		min-width: 100%;
		min-height: 100%;
		
		object-position: center center;
		object-fit: cover;
		opacity: 0.2;
		z-index: -1;
	}

	.game-heading {
		color: var(--color-text);
		text-align: center;
		font-size: var(--font-4xl);
		margin-top: var(--gap-2);

		@media (min-width: 768px) {
			font-size: var(--font-5xl);
			margin-top: var(--gap-4);
		}
	}

	.game-grid {
		display: grid;
		position: relative;
		align-self: center;
		gap: var(--gap-4);
		z-index: 10;

		/* Mobile default */
		grid-template-columns: 1fr;
		padding-inline: var(--gap-4);
		
		/* Tablet */
		@media (min-width: 1024px) {
			grid-template-columns: 1fr 1fr;
			padding-inline: var(--gap-6);
		}

		/* Desktop */
		@media (min-width: 1440px) {
			grid-template-columns: 1fr 1fr 1fr;
			padding-inline: var(--gap-8);
		}
		
		/* Large Desktop */
		@media (min-width: 1920px) {
			max-width: 1920px;
		}
	}

</style>
