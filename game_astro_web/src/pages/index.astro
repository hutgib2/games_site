---
// JavaScript Section
import DupaLogoText from '@/assets/my_logo_text.png';
import GameCard from '@/components/GameCard.astro';
// import GamePreviewReel from '@/components/GamePreviewReel.astro';
import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Image from 'astro/components/Image.astro';
import { getCollection } from 'astro:content';

const gamesCollection = await getCollection('games');

// TASK: We want to style the top half of the screen with our new design

// STEP 1: clean up the old code - remove anything we no longer need
// STEP 2: move the welcome h1 to site above the rest of the text

// STEP 3: make the welcome bold and big, and the text not bold and smaller
// STEP 4: center the text and add spacing if needed
// STEP 5: match the text color to the logo text color

---

<Layout>
	<div class="header">
		<Header {gamesCollection} />
	</div>
	<section class="body">
		<div class="welcome-section">
			<Image src={DupaLogoText} alt="Dupa Games Logo" width={240} />
			<div class="welcome">
				<h1>Welcome to Dupa Games!</h1>
				<h2>A site where I've shared all my <br /> personal games for you to enjoy... <br/> but this is mainly a portfolio in a way</h2>
			</div>
		</div>
		<h1 class="game-heading">Browse all games</h1>
		<ul class="game-grid">
			{
				gamesCollection.map((game: any) => (
					<li>
						<GameCard
							title={game.data.title}
							description={game.data.description}
							image={game.data.image}
							video={game.data.video}
							href={`games/${game.id}`}
						/>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<!-- 
	There are two ways to write CSS in an astro file
	1. Write styles inside page's <style> - only applies to elements in current file
	2. Import a css file from styles/ - can apply to multiple files or globally
-->

<!-- CSS Section - allows us to add scoped CSS to our html -->
<style>
	.header {
		position: absolute;
		inset: 0;
		z-index: 50;
		height: fit-content;
	}

	.body {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--gap-4);

		@media (min-width: 1024px) {
			gap: var(--gap-8);
		}
	}

	.welcome-section {
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: var(--color-bg-alt4);
		height: 50dvh;
		gap: 100px;
	}

	.welcome {
		text-align: center;
		
		h1 {
			font-weight: 700;
			font-size: var(--font-4xl);
			padding-bottom: var(--gap-2);
			color: var(--color-brand);
		}

		h2 {
			font-weight: 400;
			font-size: var(--font-xl);
		}
	}

	.game-heading {
		color: var(--color-text);
		text-align: center;
		font-size: var(--font-4xl);
		margin-top: var(--gap-2);

		@media (min-width: 768px) {
			font-size: var(--font-5xl);
			margin-top: var(--gap-4);
		}
	}

	.game-grid {
		display: grid;
		position: relative;
		align-self: center;
		gap: var(--gap-4);
		z-index: 10;

		/* Mobile default */
		grid-template-columns: 1fr;
		padding-inline: var(--gap-4);
		
		/* Tablet */
		@media (min-width: 1024px) {
			grid-template-columns: 1fr 1fr;
			padding-inline: var(--gap-6);
		}

		/* Desktop */
		@media (min-width: 1440px) {
			grid-template-columns: 1fr 1fr 1fr;
			padding-inline: var(--gap-8);
		}
		
		/* Large Desktop */
		@media (min-width: 1920px) {
			max-width: 1920px;
		}
	}
</style>
