---
interface Props {
  label: string;
  items: { label: string; href: string }[];
}

const { label, items }: {label: string, items: { label: string, href: string }[]} = Astro.props;
---

<script>
  // Close any open dropdown when clicking outside it or pressing Escape
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.dropdown[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('details.dropdown[open]').forEach((d) => {
        d.removeAttribute('open');
        d.querySelector('summary')?.focus();
      });
    }
  });
</script>

<details class="dropdown">
  <summary>{label}</summary>
  <ul>
    {items.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
</details>

<style lang="scss">
  .dropdown {
    position: relative;
    display: inline-block;
    font-family: var(--font-sans);

    summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: var(--gap-2);
      font-weight: var(--weight-medium);
      user-select: none;
      transition:
        color var(--duration-fast),
        border-color var(--duration-fast);

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '▾';
        transition: transform var(--duration-fast);
      }

      &:hover {
        color: var(--color-text-strong);
        border-color: var(--color-brand);
      }

      &:focus-visible {
        outline: var(--border-thick) solid var(--color-brand);
        outline-offset: var(--border-thin);
      }
    }

    &[open] summary {
      color: var(--color-text-strong);
      border-color: var(--color-brand);

      &::after { transform: rotate(180deg); }
    }

    ul {
      position: absolute;
      top: calc(100% + var(--gap-3));
      left: 0;
      margin: 0;
      list-style: none;
      background: var(--color-bg-alt2);
      border: var(--border-thin) solid var(--color-border);
      border-radius: var(--radius-sm);
      z-index: var(--z-header);
    }

    a {
      display: block;
      padding: var(--gap-2) var(--gap-4);
      font-size: var(--text-body);
      line-height: var(--leading-snug);
      color: var(--color-text);
      text-decoration: none;
      white-space: nowrap;
      transition:
        background var(--duration-fast),
        color var(--duration-fast);

      &:hover {
        background: var(--color-bg-alt);
        color: var(--color-text-strong);
      }

      &:focus-visible {
        outline: var(--border-thick) solid var(--color-brand);
        outline-offset: calc(var(--border-thick) * -1);
      }
    }
  }
</style>
