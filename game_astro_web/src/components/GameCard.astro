---
import Image from 'astro/components/Image.astro';

const { title, image, video, description, href } = Astro.props;

// We want to play the video reel on hover, currently its just a static image
// Step 1: move the video files into the content folder (done)
// Step 2: create a <video> element alongside the <Image >
// Step 3: use css to show/hide the video on hover
// 	- look at how we show and hide in the Header depending on screen size
// 	- this will work similarly, but instead of screen size, it detects hover
// 	- e.g.
// 			a:hover {}

---

<div class="game-card">
	<a {href}>
		<div class="thumbnail">
			<Image src={image} alt=`${title} image` />
			<video src={video} autoplay muted loop></video>
		</div>
		<div class="game-info">
			<h2 class="game-title">{title}</h2>
			<p class="game-description">{description}</p>
		</div>
	</a>
</div>

<!-- 
	Increase the size of the title and description text for screen size above 768
-->

<style>
	.game-card {
		transition:
			transform 0.3s ease,
			color 0.3s ease;
	}

	.game-card:hover {
		color: var(--color-brand);
		transform: scale(1.01);
	}

	.thumbnail {
		width: 100%;
		aspect-ratio: 1.6;
		overflow: hidden;
		border-radius: var(--radius-lg);

		video {
			display: none;
		}
		
		img {
			display: block;
			width: 100%;
			height: 100%;
			object-position: center center;
			object-fit: cover;
		}
	}
	
	.thumbnail:hover {
		img {
			display: none;
		}

		video {
			display: block;
			width: 100%;
			height: 100%;
			object-position: center center;
			object-fit: cover;
		}
	}

	.game-info {
		display: flex;
		flex-direction: column;
		padding-inline: var(--gap-2);
	}

	.game-title {
		font-size: var(--font-2xl);
		
		@media (min-width: 768px) {
			font-size: var(--font-3xl);
		}
	}

	.game-description {
		color: var(--color-text-muted);
		font-size: var(--font-base);
		
		@media (min-width: 768px) {
			font-size: var(--font-lg);
		}
	}
</style>
