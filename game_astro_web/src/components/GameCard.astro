---
import Image from 'astro/components/Image.astro';

const { title, image, video, description, href } = Astro.props;
---
<script>
	document.querySelectorAll<HTMLElement>('.game-card').forEach((card) => {
		const video = card.querySelector('video');
		if (!video) return;

		card.addEventListener('mouseenter', () => video.play().catch(() => {}));
		card.addEventListener('mouseleave', () => {
			video.pause();
			video.currentTime = 0; // reset video to start 
		});
	});
</script>

<div class="game-card">
	<a {href}>
		<div class="thumbnail">
			<Image src={image} alt=`${title} image` />
			<video src={video} muted loop playsinline preload="auto"></video>
		</div>
		<div class="game-info">
			<h2 class="game-title">{title}</h2>
			<p class="game-description">{description}</p>
		</div>
	</a>
</div>

<!--
	Type sizes are fluid tokens (--text-*), so no breakpoint is needed here.
	All values come from tokens.css.
-->
<style>
	.game-card {
		width: 100%;
		height: 100%;
	}

	.game-card a {
		display: flex;
		flex-direction: column;
		gap: var(--gap-3);
		height: 100%;
	}

	.thumbnail {
		position: relative;
		width: 100%;
		aspect-ratio: var(--card-thumb-ratio);
		overflow: hidden;
		background-color: var(--color-bg-alt3); /* shows while the image loads */
		border-radius: var(--radius-md);
	}

	.thumbnail img,
	.thumbnail video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.thumbnail video {
		opacity: 0;
		transition: opacity var(--duration-fast) ease;
	}

	.game-card:hover .thumbnail video {
		opacity: 1;
	}

	.game-info {
		display: flex;
		flex-direction: column;
		gap: var(--gap-1);
		padding-inline: var(--gap-2);
	}

	.game-title {
		font-size: var(--text-title);
		font-weight: var(--weight-bold);
		line-height: var(--leading-snug);
		color: var(--color-text-strong);
		transition: color var(--duration-fast) ease;
	}

	.game-card a:hover .game-title {
		color: var(--color-brand);
	}

	.game-description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: var(--card-description-lines);
		line-clamp: var(--card-description-lines);
		overflow: hidden;
		font-size: var(--text-body);
		line-height: var(--leading-snug);
		color: var(--color-text-subtle);
		text-wrap: pretty;
	}
</style>