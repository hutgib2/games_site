---
import Image from 'astro/components/Image.astro';

const { title, image, video, description, href } = Astro.props;
---
<script>
	document.querySelectorAll<HTMLElement>('.game-card').forEach((card) => {
		const video = card.querySelector('video');
		if (!video) return;

		card.addEventListener('mouseenter', () => video.play().catch(() => {}));
		card.addEventListener('mouseleave', () => {
			video.pause();
			video.currentTime = 0; // reset video to start 
		});
	});
</script>

<div class="game-card">
	<a {href}>
		<div class="thumbnail">
			<!-- <video src={video} autoplay muted loop></video> -->
			<Image src={image} alt=`${title} image` />
			<video src={video} muted loop playsinline preload="auto"></video>
		</div>
		<div class="game-info">
			<h2 class="game-title">{title}</h2>
			<p class="game-description">{description}</p>
		</div>
	</a>
</div>

<!-- 
	Increase the size of the title and description text for screen size above 768
-->

<style>
	/* .game-card {
		transition:
			transform 0.3s ease,
			color 0.3s ease;
	} */

	.thumbnail {
		position: relative;
		width: 100%;
		aspect-ratio: 1.6;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.thumbnail img,
	.thumbnail video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.thumbnail video {
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.game-card:hover .thumbnail video {
		opacity: 1;
	}

	.game-info {
		display: flex;
		flex-direction: column;
		padding-inline: var(--gap-2);
	}

	.game-title {
		font-size: var(--font-2xl);
		
		@media (min-width: 768px) {
			font-size: var(--font-3xl);
		}
	}

	.game-description {
		color: var(--color-text-muted);
		font-size: var(--font-base);
		
		@media (min-width: 768px) {
			font-size: var(--font-lg);
		}
	}
</style>
