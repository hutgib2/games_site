---
import { type CollectionEntry } from 'astro:content';
import { Menu, Button, Sheet, Select } from 'webcoreui/astro';
import DupaLogo from '../assets/my_logo.png';
import MenuIcon from '@lucide/astro/icons/menu';

const menu = [
	{ name: 'Home', href: '/', active: true },
	{ name: 'About', href: '/about', active: true },
];

const menuLogo = {
	url: DupaLogo.src,
	width: 48,
};

// Define the props that Header takes
const { gamesCollection } = Astro.props;

// Task: create a sidebar sheet when the menu icon is clicked

// Step 1: find a menu icon that you like on lucide 
// Step 2: copy the code from the webcoreui sheet into this file
// Step 3: add the menu content to the sheet, e.g. list of games, link to home
	// 	- use <a> to create "Home" and "About" links

// Step 4: adjust any of the code to fit the style you want
	// - give the sheet a bg color
	// - style the text 
	// - write a Games header above the list of games
	// - add padding and indentation inside the sheet
	// - add interactivity to the button when its clicked (I will help with this)

const GAMES = gamesCollection.map((game: CollectionEntry<'games'>) => ({
	name: game.data.title,
	href: `/games/${game.id}`,
}))
---

<script>
	import { modal } from 'webcoreui';

	modal({
		trigger: '.button',
		modal: '.sheet'
	})
</script>

<header>
	<div class="mobile-header">
		<Button className="button"><MenuIcon /></Button>
		<Sheet className="sheet" position="left" showCloseIcon={false}>
			<a href="/">Home</a>
			<a href="/about">About</a>
			<h3>Games</h3>
			{
				GAMES.map((game) => (
					<a href={game.href}>
						{game.name}
					</a>
				))
			}
		</Sheet>
	</div>

	<div class="desktop-header">
		<Menu items={menu} logo={menuLogo} />
		<div class="select-wrapper">
			<Select
				name="select-id"
				itemGroups={[{ items: GAMES }]}
				showSearchBar={false}
				showSearchBarIcon={false}
				placeholder="Games"
			/>
		</div>
	</div>
</header>

<style>
	/* Show dropdown bar */
	.mobile-header {
		display: flex;
		justify-content: flex-end;
		
		:global(.sheet) {
			display: flex;
			flex-direction: column;
			background-color: var(--color-bg);
			font-family: var(--font-oswald);
			font-size: var(--font-xl);
			font-weight: bold;
			padding: var(--gap-4);
		}
	}

	.desktop-header {
		display: none;
	}

	/* Show full header bar */
	@media (min-width: 1024px) {
		.mobile-header {
			display: none;
		}
		
		.desktop-header {
			display: flex;
			align-items: center;

			font-family: var(--font-oswald);
			font-size: var(--font-lg);
			font-weight: bold;
			
			.select-wrapper {
				/* to align with rest of header items */
				transform: translateY(3) translateX(-24);
			}

			/* NOT WORKING 
			:global([class*="w-"]) {
			  font-family: var(--font-oswald);
			} */
		}
	}

	
</style>
