---
import { type CollectionEntry } from 'astro:content';
import { Menu, Button, Sheet, Select } from 'webcoreui/astro';
import DupaLogo from '../assets/my_logo.png';
import MenuIcon from '@lucide/astro/icons/menu';
import Image from 'astro/components/Image.astro';

const menu = [
	{ name: 'Home', href: '/', active: true },
	{ name: 'About', href: '/about', active: true },
];

const menuLogo = {
	url: DupaLogo.src,
	width: 48,
};

const { gamesCollection } = Astro.props;

const GAMES = gamesCollection.map((game: CollectionEntry<'games'>) => ({
	name: game.data.title,
	href: `/games/${game.id}`,
}))
---

<script>
	import { modal } from 'webcoreui';

	modal({
		trigger: '.button',
		modal: '.sheet'
	})
</script>

<header>
	<div class="mobile-header">
		<Button className="button">
			<MenuIcon stroke-width={2} size={38} />
		</Button>
		
		<Sheet className="sheet" position="left" showCloseIcon={false}>
			<a href="/" class="img-wrapper">
				<Image src={DupaLogo} alt="Dupa Games Logo" width={80} />
			</a>
			<a href="/">Home</a>
			<a href="/about">About</a>
			<h3 class="games-heading">Games</h3>
			<div class="games-list">
				{
					GAMES.map((game) => (
						<a href={game.href}>
							{game.name}
						</a>
					))
				}
			</div>
		</Sheet>
	</div>

	<div class="desktop-header">
		<Menu items={menu} logo={menuLogo} />
		<div class="select-wrapper">
			<Select
				name="select-id"
				itemGroups={[{ items: GAMES }]}
				showSearchBar={false}
				showSearchBarIcon={false}
				placeholder="Games"
			/>
		</div>
	</div>
</header>

<style>
	.mobile-header {
		display: flex;
		justify-content: flex-end;
		width: 100%;
 
		.button {
			padding: var(--gap-4);
			transition: transform var(--duration-fast) ease;
		}
 
		.button:hover {
			color: var(--color-brand);
			transform: scale(var(--scale-hover));
		}
 
		.menu-icon {
			width: var(--size-icon-md);
			height: var(--size-icon-md);
		}
 
		& a {
			width: fit-content;
			padding-block: var(--gap-1);
		}
 
		a:hover {
			color: var(--color-brand);
			transform: scale(var(--scale-hover));
			transition: transform var(--duration-fast) ease;
		}
 
		.sheet {
			display: flex;
			flex-direction: column;
			width: var(--sheet-width);
			padding: var(--gap-6);
			background-color: var(--color-bg);
			border-right: var(--border-thin) solid var(--color-border);
			font-family: var(--font-sans);
			font-size: var(--text-title);
			font-weight: var(--weight-bold);
 
			a.img-wrapper {
				padding-bottom: var(--gap-6);
				transform: none;
			}
		}
 
		.sheet-logo {
			width: var(--size-logo-sm);
			height: auto;
		}
 
		.games-list {
			display: flex;
			flex-direction: column;
			padding-inline: var(--gap-6);
		}
 
		.games-heading {
			padding-top: var(--gap-6);
			font-size: var(--text-title);
			font-weight: var(--weight-regular);
			color: var(--color-text-subtle);
		}
	}

	.desktop-header {
		display: none;
	}

	/* Show full header bar */
	@media (min-width: 1024px) {
		.mobile-header {
			display: none;
		}
		
		.desktop-header {
			display: flex;
			align-items: center;

			font-family: var(--font-oswald);
			font-size: var(--font-lg);
			font-weight: bold;
			background-color: var(--color-bg);
			border-bottom: var(--border-thin) solid var(--color-border);

			
			.select-wrapper {
				/* to align with rest of header items */
				transform: translateY(3) translateX(-24);
			}
		}
	}

	
</style>
