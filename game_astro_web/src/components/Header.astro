---
import { type CollectionEntry } from 'astro:content';
import { Sheet } from 'webcoreui/astro';
import DropDown from './DropDown.astro';
import DupaLogo from '../assets/my_logo.png';
import MenuIcon from '@lucide/astro/icons/menu';
import Image from 'astro/components/Image.astro';

const menuLinks = [
	{ name: 'Home', href: '/' },
	{ name: 'Credits', href: '/credits' }
];

const { gamesCollection } = Astro.props;

const GAMES = gamesCollection.map((game: CollectionEntry<'games'>) => ({
	name: game.data.title,
	href: `/games/${game.id}`,
}))
---

<script>
	import { modal } from 'webcoreui';

	modal({
		trigger: '.toggle-sidebar',
		modal: '.sheet'
	})
</script>

<header>
	<div class="mobile-header">
		<button class="toggle-sidebar">
			<MenuIcon stroke-width={2} size={38} />
		</button>
		
		<Sheet className="sheet" position="left" showCloseIcon={false}>
			<!-- <a href="/" class="img-wrapper">
				<Image src={DupaLogo} alt="Dupa Games Logo" width={80} />
			</a> -->
			{
				menuLinks.map((item) => (
					<a href={item.href} class="menu-link">{item.name}</a>
				))
			}
			<h3 class="games-heading">All Games</h3>
			<div class="games-list">
				{
					GAMES.map((game: any) => (
						<a href={game.href}>{game.name}</a>
					))
				}
			</div>
		</Sheet>
	</div>

	<div class="desktop-header">
		<a href="/"><Image src={DupaLogo} alt="Dupa Games Logo" width={64}/></a>
		{
			menuLinks.map((item) => (
				<a href={item.href}>{item.name}</a>
			))
		}
		<DropDown label='Games' items={(GAMES.map((game: any) => (
			{ label: game.name, href: game.href }
		)))}/>
	</div>
</header>

<style>
	/* shared by both */
	a:hover {
		color: var(--color-brand);
		transform: scale(var(--scale-hover));
		transition: transform var(--duration-fast) ease;
	}
	
	/* mobile only - sidebar menu */
	.mobile-header {
		display: flex;
		justify-content: flex-end;
		width: 100%;
		
		.toggle-sidebar {
			padding: var(--gap-3);
			transition: transform var(--duration-fast) ease;
		}
		
		.toggle-sidebar:hover {
			color: var(--color-brand);
			transform: scale(var(--scale-hover));
		}
		
		.menu-icon {
			width: var(--size-icon-md);
			height: var(--size-icon-md);
		}
		
		a {
			width: fit-content;
		}
		
		.sheet {
			display: flex;
			flex-direction: column;
			width: var(--sheet-width);
			padding-inline: var(--gap-6);
			padding-block: var(--gap-12);
			border-right: var(--border-thin) solid var(--color-border);
			
			font-family: var(--font-sans);
			font-size: var(--text-title);
			font-weight: var(--weight-bold);
			background-color: var(--color-bg);
			
			.games-list {
				display: flex;
				flex-direction: column;
				white-space: nowrap;
			}

			a.img-wrapper {
				padding-bottom: var(--gap-6);
				transform: none;
			}
		}
 
		.sheet-logo {
			width: var(--size-logo-sm);
			height: auto;
		}

		.menu-link {
			font-size: var(--font-2xl);
		}
 
		.games-list {
			padding-inline: var(--gap-4);
			gap: var(--gap-2);
		}
 
		.games-heading {
			padding-top: var(--gap-6);
			font-size: var(--text-title);
			font-weight: var(--weight-regular);
			color: var(--color-text-subtle);
		}
	}
	
	.desktop-header {
		display: none;
	}

	
	/* desktop only - full header bar */
	@media (min-width: 1024px) {
		.mobile-header {
			display: none;
		}
		
		.desktop-header {
			display: flex;
			align-items: center;
			gap: var(--gap-4);

			font-family: var(--font-oswald);
			font-size: var(--font-lg);
			font-weight: bold;
			background-color: var(--color-bg);
			border-bottom: var(--border-thin) solid var(--color-border);
			padding-inline: var(--gutter);
			padding-block: var(--gap-3);
		}
	}
</style>
