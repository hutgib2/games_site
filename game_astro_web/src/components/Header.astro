    import { listen } from 'webcoreui'

    listen('selectOnChange', (event) => console.log(event))
    listen('selectOnClose', (event) => console.log(event))
</script> -->

<style>
	/* Show dropdown bar */
	.mobile-header {

	}

	.desktop-header {
		display: none;
	}

	/* Show full header bar */
	@media (min-width: 768px) {
		.mobile-header {
			display: none;
		}
		
		.desktop-header {
			display: flex;
			align-items: center;

			font-family: var(--font-oswald);
			font-size: var(--font-l);
			font-weight: bold;
			
			.select-wrapper {
				/* to align with rest of header items */
				transform: translateY(3) translateX(-24);
			}

			/* NOT WORKING 
			:global([class*="w-"]) {
			  font-family: var(--font-oswald);
			} */
		}
	}
</style>
