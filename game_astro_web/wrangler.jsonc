{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "game-astro-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "games",
			"database_id": "118e3f7b-e5c1-45f3-bffc-14fe295f2553"
		}
	],
}